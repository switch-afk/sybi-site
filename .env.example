ADMIN_PASSWORD=pick-something-strong

# Shown in the Faucet / Create Token popups
NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/your-invite-code

# Discord bot
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-client-id
DISCORD_GUILD_ID=your-server-id

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
TREASURY_SECRET_KEY=your-treasury-wallet-secret-key

# Limits
FAUCET_MAX_SOL_PER_CLAIM=2
FAUCET_MAX_SOL_PER_24H=2
TOKEN_CREATIONS_MAX_PER_24H=3
