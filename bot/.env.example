# Discord
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-client-id
# Optional: set this to your server's ID while testing so slash commands
# register instantly (guild commands). Remove it to register globally
# (takes up to ~1 hour to propagate, but works in every server the bot is in).
DISCORD_GUILD_ID=your-server-id

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
# Base58 secret key (the long string Phantom/Solflare export as "Show private key"),
# OR a JSON array like [12,34,...] (what solana-keygen writes). Either works.
TREASURY_SECRET_KEY=your-treasury-wallet-secret-key

# Limits
FAUCET_MAX_SOL_PER_CLAIM=2
FAUCET_MAX_SOL_PER_24H=2
TOKEN_CREATIONS_MAX_PER_24H=3
